# RG Midrand identity; HustleAI developer backend. Use only Meta test assets.
# Enter secrets locally with: .venv/bin/python -m hustleai.integrations.whatsapp.test_assistant configure
WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1417138624811816
WHATSAPP_TEST_RECIPIENT=+27837758811
WHATSAPP_API_VERSION=v23.0

# Owner dashboard live sign-in. Enter locally using --live --configure-owner.
HUSTLEAI_OWNER_PASSWORD=
# HTTPS origin only, e.g. https://dashboard.example.com (no trailing slash).
# Leave empty for local HTTP. Forward the original Host through the HTTPS proxy.
HUSTLEAI_PUBLIC_ORIGIN=
# Restricted Hermes API, checked before every draft. Use "restricted" for a
# separate profile, or explicitly approved "existing-restricted" on localhost.
HUSTLEAI_HERMES_URL=
HUSTLEAI_HERMES_API_KEY=
HUSTLEAI_HERMES_CUSTOMER_PROFILE=

# Owner-only bank reconciliation report email (use the hidden-prompt setup helper)
HUSTLEAI_REPORT_EMAIL=
HUSTLEAI_SMTP_HOST=
HUSTLEAI_SMTP_PORT=465
HUSTLEAI_SMTP_FROM=
HUSTLEAI_SMTP_USER=
HUSTLEAI_SMTP_PASSWORD=

# Optional owner-approved issued test invoice for the fixed WhatsApp test recipient.
# Read-only draft context fallback only; real-order selection and other phones are unchanged.
HUSTLEAI_TEST_HISTORY_INVOICE=
