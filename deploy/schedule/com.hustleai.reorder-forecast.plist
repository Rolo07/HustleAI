<?xml version="1.0" encoding="UTF-8"?>
<!-- Mac: weekly reorder forecast, Mondays 07:00 in the Mac's own timezone.
     Replace the checkout path, copy to ~/Library/LaunchAgents/, then run:
     launchctl load ~/Library/LaunchAgents/com.hustleai.reorder-forecast.plist
     Use either this or the VPS timer, not both. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hustleai.reorder-forecast</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/rolandachary/Desktop/HustleAI/.venv/bin/hustleai-forecast</string>
        <string>run</string>
        <string>--send</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/hustleai-forecast.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/hustleai-forecast.log</string>
</dict>
</plist>
