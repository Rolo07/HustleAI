# VPS: nightly orders sync from Zoho. Copy to /etc/systemd/system/ with the timer.
[Unit]
Description=HustleAI nightly orders sync from Zoho
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=hermes
Environment=HUSTLEAI_DATA_DIR=/var/lib/hustleai
ExecStart=/opt/hustleai/.venv/bin/hustleai-orders sync
