[Unit]
Description=HustleAI stable HTTPS dashboard and Meta webhook
Wants=network-online.target
After=network-online.target hustleai-dashboard.service

[Service]
User=hustleai-https
Group=hustleai-https
WorkingDirectory=/var/lib/hustleai-https
EnvironmentFile=/etc/hustleai-dashboard/https.env
Environment=XDG_DATA_HOME=/var/lib/hustleai-https/data
Environment=XDG_CONFIG_HOME=/var/lib/hustleai-https/config
ExecStart=/opt/hustleai-dashboard/tools/caddy-https run --config /opt/hustleai-dashboard/current/deploy/vps/https.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hustleai-https
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
